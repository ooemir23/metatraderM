# Copy to .env and supply your own values. Never commit .env.
VNC_PASSWORD=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=Tickmill-Demo
MT5_ACCOUNT_TYPE=
DEEPSEEK_API_KEY=
AI_DAILY_CALL_LIMIT=100
AI_DAILY_TOKEN_LIMIT=100000
AI_AUTOPILOT_BUDGET_FRACTION=0.8
AI_MAX_TRADE_RISK_PCT=1

# Panel login (required). Use HTTPS outside localhost.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Optional second operator. Set both values to activate a separate login.
DASHBOARD_USER_2=
DASHBOARD_PASSWORD_2=
DASHBOARD_ROLE_2=TRADER
ENABLE_DEBUG_API=0
# Account currency; UTC day. Saved panel risk setting overrides this initial default.
DAILY_LOSS_LIMIT=500
# Additional gross exposure limits across open positions and pending orders.
MAX_ORDER_LOTS=0.10
MAX_TOTAL_OPEN_LOTS=0.50
MAX_OPEN_ORDERS=10
